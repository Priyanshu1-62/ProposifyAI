# Stage 1: Build

FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma

RUN npm ci

COPY . . 

RUN npm run build

# Stage 2: Production Runtime
# Build stage contains TS compiler, dev dependencies, ts-node-dev, build tooling
# In this stage, we only want transpiled JS, prod dependencies, Prisma runtime artifacts
# A fresh image, fresh /app, fresh filesystem for production

FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma

RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist

# Copying runtime binaries generated by Prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

EXPOSE 5000

CMD ["npm", "start"]